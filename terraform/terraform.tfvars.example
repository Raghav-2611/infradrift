# ============================================================
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is listed in .gitignore and must NEVER be
# committed to version control — it may contain sensitive data.
# ============================================================

# AWS region to deploy resources into.
aws_region = "us-east-1"

# Short name used as a tag/prefix on every resource.
project = "infradrift"

# Deployment environment label.
environment = "dev"

# EC2 instance type for the drift-demo server.
instance_type = "t3.small"


# AMI ID — Amazon Linux 2023 in us-east-1.
# If you change aws_region, update this value.
# Find the latest AMI for your region:
#   aws ec2 describe-images \
#     --owners amazon \
#     --filters "Name=name,Values=al2023-ami-*-x86_64" \
#     --query "sort_by(Images, &CreationDate)[-1].ImageId" \
#     --output text
ami_id = "ami-0c02fb55956c7d316"

# Name of an existing EC2 key pair for SSH access.
# Leave empty to disable SSH (access via AWS SSM Session Manager instead).
key_pair_name = ""

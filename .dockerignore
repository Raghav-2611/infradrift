# Dependencies — installed fresh inside the container
node_modules/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local build outputs
dist/
build/

# Version control & editor
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Terraform runtime & state files (prevent baking state/credentials into image)
terraform/.terraform/
terraform/*.tfstate*
terraform/terraform.tfvars
terraform/plans/*.tfplan
terraform/plans/*.json

# Lint config
.oxlintrc.json

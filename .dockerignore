# Dependencies — installed fresh inside the container
node_modules/

# Local build output — rebuilt inside the container
dist/

# Version control
.git/
.gitignore

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files (never bake secrets into images)
.env
.env.*

# Lint config (not needed at runtime)
.oxlintrc.json
